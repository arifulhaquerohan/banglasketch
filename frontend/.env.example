# Optional Express backend URL. Do not expose secrets with NEXT_PUBLIC_ variables.
API_URL=http://localhost:5000
NEXT_PUBLIC_API_URL=http://localhost:5000

NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name
REVALIDATE_SECRET=replace-with-the-same-backend-revalidation-secret



# VPS only: enable behind Nginx that overwrites X-Real-IP; bind Next to loopback.
TRUST_INGRESS_IP=false
