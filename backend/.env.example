PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/banglasketch

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# SMTP / Nodemailer
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

CONTACT_EMAIL=info@banglasketch.com

# Admin Authentication
# Generate ADMIN_JWT_SECRET with: openssl rand -hex 32
ADMIN_JWT_SECRET=replace-with-a-long-random-jwt-secret
# Generate both keys with: openssl rand -base64 32
TOTP_ENCRYPTION_KEY=replace-with-base64-32-byte-key
BACKUP_ENCRYPTION_KEY=replace-with-another-base64-32-byte-key
METRICS_TOKEN=replace-with-a-long-random-monitoring-token
# Generate ADMIN_PASSWORD_HASH with: node -e "console.log(require('bcryptjs').hashSync('your_admin_password', 10))"
ADMIN_PASSWORD_HASH=replace-with-bcrypt-hash

# Admin Recovery & Notification Email
# Email address used for forgot-password OTP and login security notifications.
# Defaults to arifulhaquerohan@gmail.com if not set.
# ADMIN_RECOVERY_EMAIL=arifulhaquerohan@gmail.com
# Optional: override notification recipient independently of SMTP user.
# ADMIN_NOTIFICATION_EMAIL=arifulhaquerohan@gmail.com


# Network: default is local Nginx/Next only. Containers may require HOST=0.0.0.0.
HOST=127.0.0.1
TRUST_PROXY=loopback
DB_POOL_MAX=10
DB_CONNECTION_TIMEOUT_MS=5000
DB_STATEMENT_TIMEOUT_MS=10000
DB_QUERY_TIMEOUT_MS=12000
# Remote PostgreSQL verifies TLS. Set this if your provider needs a custom CA.
# DB_SSL_CA_FILE=/absolute/path/provider-ca.pem
# ADMIN_PASSWORD_HASH bootstraps an empty credentials table only.
BACKUP_DIR=./backups
# Optional scheduled-publish cache refresh endpoint and shared secret.
# REVALIDATE_URL=http://127.0.0.1:3000/api/revalidate
# REVALIDATE_SECRET=replace-with-a-long-random-secret
# Optional comma-separated additions/replacement for disposable email blocking.
# DISPOSABLE_EMAIL_DOMAINS=mailinator.com,guerrillamail.com,10minutemail.com
