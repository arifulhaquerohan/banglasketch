# Development mode. Set NODE_ENV=production on the server.
NODE_ENV=development

# Leave empty to use django_backend/db.sqlite3 locally.
# Production example: postgresql://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_URL=
CONN_MAX_AGE=60
DB_SSL_MODE=require
DB_SSL_CA_FILE=

# Generate unique, private values for production.
DJANGO_SECRET_KEY=replace-with-a-long-random-django-secret
ADMIN_JWT_SECRET=replace-with-a-long-random-jwt-secret
TOTP_ENCRYPTION_KEY=replace-with-32-byte-base64-key
BACKUP_ENCRYPTION_KEY=replace-with-32-byte-aes-key

# Comma-separated browser origins and hostnames.
FRONTEND_URL=http://localhost:3000,http://127.0.0.1:3000
ALLOWED_HOSTS=localhost,127.0.0.1

# Email delivery & Notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
CONTACT_EMAIL=
ADMIN_RECOVERY_EMAIL=

# Cloudinary media storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
