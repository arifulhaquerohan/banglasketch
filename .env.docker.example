# ==============================================================================
# Bangla Sketch Production Docker Environment Configuration Template
# Copy this file to .env.docker and replace placeholder values before deployment.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PostgreSQL Database Configuration
# ------------------------------------------------------------------------------
POSTGRES_DB=banglasketch_db
POSTGRES_USER=banglasketch_user
POSTGRES_PASSWORD=replace_with_a_strong_database_password_32chars
POSTGRES_PORT=5432

# ------------------------------------------------------------------------------
# 2. Django Security & Secret Keys (Generate with: python -c 'import secrets; print(secrets.token_urlsafe(50))')
# ------------------------------------------------------------------------------
DJANGO_SECRET_KEY=replace_with_a_random_50_character_django_secret_key
ADMIN_JWT_SECRET=replace_with_a_random_32_byte_jwt_signing_secret
# 32-byte Base64-encoded key for AES-256-GCM 2FA TOTP encryption
# Generate with: python -c 'import secrets, base64; print(base64.b64encode(secrets.token_bytes(32)).decode())'
TOTP_ENCRYPTION_KEY=MTIzNDU2Nzg5MDEyMzQ1Njc4OTAxMjM0NTY3ODkwMTI=

NODE_ENV=production
ALLOWED_HOSTS=yourdomain.com,api.yourdomain.com,localhost,127.0.0.1,django_api
FRONTEND_URL=https://yourdomain.com,http://localhost:3000

# ------------------------------------------------------------------------------
# 3. Superuser Automatic Bootstrapping (Optional for first run)
# ------------------------------------------------------------------------------
AUTO_SETUP_ADMIN=false
ADMIN_INITIAL_PASSWORD=replace_with_initial_admin_password
ADMIN_RECOVERY_EMAIL=admin@banglasketch.com

# ------------------------------------------------------------------------------
# 4. Cloudinary Media & Invoice PDF Archival Storage
# ------------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ------------------------------------------------------------------------------
# 5. SMTP Email Configuration (Google Workspace / Amazon SES / Brevo)
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=info@banglasketch.com
SMTP_PASS=your_smtp_app_password_without_spaces
CONTACT_EMAIL=info@banglasketch.com
ADMIN_NOTIFICATION_EMAIL=admin@banglasketch.com

# ------------------------------------------------------------------------------
# 6. AI Consultation Chatbot Provider Credentials (Optional)
# ------------------------------------------------------------------------------
CHATBOT_ACTIVE_PROVIDER=gemini
GEMINI_API_KEY=your_google_gemini_api_key
OPENAI_API_KEY=your_openai_api_key

# ------------------------------------------------------------------------------
# 7. Frontend & Ports
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://django_api:5000
FRONTEND_PORT=3000
DJANGO_PORT=5000
REDIS_PORT=6379
